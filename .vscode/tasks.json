{
    "version": "2.0.0",
    "options": {
        "env": {
            "PATH": "${env:GDK}\\bin;${env:PATH}"
        }
    },
    "tasks": [
        {
            "label": "SGDK: build",
            "type": "shell",
            "command": "${env:GDK}\\bin\\make.exe",
            "args": [
                "-f",
                "${env:GDK}\\makefile.gen"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "SGDK: clean",
            "type": "shell",
            "command": "${env:GDK}\\bin\\make.exe",
            "args": [
                "-f",
                "${env:GDK}\\makefile.gen",
                "clean"
            ],
            "problemMatcher": []
        },
        {
            "label": "SGDK: clean and build",
            "dependsOrder": "sequence",
            "dependsOn": [
                "SGDK: clean",
                "SGDK: build"
            ],
            "problemMatcher": []
        },
        {
            "label": "SGDK: publish rom to docs/",
            "type": "shell",
            "command": "${env:GDK}\\bin\\cp.exe",
            "args": [
                "out/rom.bin",
                "docs/rom.bin"
            ],
            "problemMatcher": []
        },
        {
            "label": "SGDK: build and publish",
            "dependsOrder": "sequence",
            "dependsOn": [
                "SGDK: build",
                "SGDK: publish rom to docs/"
            ],
            "problemMatcher": []
        }
    ]
}
